{
  "name": "neroviax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:setup && next dev",
    "build": "next build",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-postgres.mjs",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-postgres.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/check-postgres.mjs",
    "start": "pnpm db:setup && next start",
    "lint": "eslint .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-isolation=none lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.2.11",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2"
  },
  "packageManager": "pnpm@11.15.1"
}
