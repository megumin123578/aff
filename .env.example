# Public site URL used by sitemap.xml and robots.txt.
# Production example: https://neroviax.com
# Use https://neroviax.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Awin ownership verification value or publisher token.
# Use "Awin" when the application only asks for the network name in source.
AWIN_VERIFICATION=

# Public Google AdSense publisher account. This identifier is not a secret.
NEXT_PUBLIC_GOOGLE_ADSENSE_ACCOUNT=ca-pub-4003831741640664

# PostgreSQL -----------------------------------------------------------------
# Add ?sslmode=require when your managed PostgreSQL provider requires TLS.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neroviax

# Optional: only needed when the credentials/host used to CREATE DATABASE differ.
# The database user must have CREATE DATABASE permission.
# POSTGRES_MAINTENANCE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Admin authentication -------------------------------------------------------
# Generate AUTH_SECRET:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Login username for /admin/login.
ADMIN_USERNAME=admin

# Plaintext password used to sign in at /admin/login.
# Use a long, unique password and keep this server-side environment file private.
ADMIN_PASSWORD=

# Separate HMAC key used only when comparing the admin password.
# Generate it with the same command as AUTH_SECRET, but use a different value.
ADMIN_PASSWORD_KEY=
